{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Celsus",
  "version": "0.2611.0",
  "identifier": "io.github.byte-me-pls.celsus",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Celsus",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
