{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "Celsus",
  "bundle": {
    "targets": ["nsis"],
    "publisher": "Celsus",
    "shortDescription": "Translates books without breaking their layout",
    "resources": {
      "../../target/release/celsus-mcp.exe": "celsus-mcp.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish", "German", "French", "Spanish", "Italian", "PortugueseBR", "Dutch", "Polish", "Russian", "Ukrainian", "Arabic", "Hindi", "Indonesian", "SimpChinese", "Japanese", "Korean"],
        "displayLanguageSelector": false
      }
    }
  }
}
