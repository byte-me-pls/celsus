# Settings for compose.yml: copy to .env next to it. install.sh writes a filled-in copy; keep it private (chmod 600).

# Database password: long and random. install.sh makes one.
POSTGRES_PASSWORD=

# --- With a domain name (recommended): Caddy gets an HTTPS certificate automatically.
# Point the domain's DNS at this machine and forward ports 80 and 443 to it.
COMPOSE_PROFILES=https
CELSUS_DOMAIN=library.example.com
CELSUS_PUBLIC_URL=https://library.example.com
CELSUS_BIND=127.0.0.1

# --- Home network only, no domain: comment out the four lines above and use these instead.
# Sessions then travel unencrypted on your network; never expose this port to the internet.
# CELSUS_BIND=0.0.0.0
# CELSUS_INSECURE_HTTP=1

# Optional
# CELSUS_VERSION=latest
# CELSUS_PORT=8080
# CELSUS_MAX_UPLOAD_MB=300
