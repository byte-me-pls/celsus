# Files that run or are read on Linux keep Unix line endings on every checkout, Windows included.
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Caddyfile text eol=lf
*.env.example text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
*.pdf binary
